# SAM deploy configuration template for athlenz-event-ingestor.
#
# Copy this file to `samconfig.toml` and fill in your values. `samconfig.toml`
# itself is gitignored because parameter_overrides contains a secret.
#
# With this in place you can deploy with a plain `sam deploy` (no --guided).

version = 0.1

[default.global.parameters]
stack_name = "athlenz-event-ingestor"

[default.build.parameters]
use_container = false

[default.deploy.parameters]
stack_name = "athlenz-event-ingestor"
region = "eu-west-1"
confirm_changeset = true
capabilities = "CAPABILITY_IAM"
resolve_s3 = true
# Secret lives here when using samconfig; keep this file out of source control.
parameter_overrides = [
  "StravaVerifyToken=<your-verify-token>",
]
